FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    BOOSTER_WEB_MODE=demo

WORKDIR /app
COPY . /app

RUN pip install --no-cache-dir uv \
    && uv sync --frozen --no-dev \
    && uv run booster web prepare-demo --project . --timeout-seconds 1800 \
    && rm -rf /app/.git

EXPOSE 8000

CMD ["uv", "run", "booster", "web", "--mode", "demo", "--project", ".", "--host", "0.0.0.0", "--port", "8000"]
